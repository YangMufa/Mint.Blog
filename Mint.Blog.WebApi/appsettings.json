// 生产环境配置-本地启动时同名配置会被appsettings.Development.json覆盖
{
  // ---- 必须手动自定义配置: 数据库 ----
  "PostgreSql": {
    // PostgreSQL 连接字符串
    // 格式: Host=主机;Port=端口;Database=库名;Username=用户名;Password=密码
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=Mint.Blog;Username=postgres;Password=example-password"
  },

  // ---- 必须手动自定义配置: RustFS 对象存储（图片/文件上传）----
  "RustFS": {
    // 后端访问 RustFS 服务地址
    "Endpoint": "http://127.0.0.1:9000",
    // 后端访问 RustFS 时是否启用 SSL,建议不启用
    "UseSsl": false,
    // 前端访问图片时使用的公开地址
    "PublicEndpoint": "https://img.example.dev",
    // RustFS AccessKey
    "AccessKey": "example-access-key",
    // RustFS SecretKey
    "SecretKey": "example-secret-key",
    // 存储桶名称
    "BucketName": "blog-article"
  },


  // 日志配置
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          // 相对路径以 systemd 的 WorkingDirectory（/opt/mint-blog）为基准
          "path": "logs/mint-blog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  },

  // ---- JWT 认证 ----
  "Jwt": {
    // 签发者标识，一般不需要改
    "Issuer": "Mint.Blog",
    // 接收者标识，一般不需要改
    "Audience": "Mint.Blog",
    // JWT 签名密钥，请替换为至少 32 位的随机字符串
    // "SecurityKey": "请替换为至少32位以上的生产密钥",
    "SecurityKey": "mint-blog-production-secret-key-2026-hs256",
    // AccessToken 过期时间（分钟）
    "AccessTokenExpireMinutes": 120
  },

  // ---- 邮件发送（SMTP）----
  "Smtp": {
    // SMTP 服务器地址，如 smtp.qq.com / smtp.163.com
    "Host": "smtp.qq.com",
    // SMTP 端口，QQ邮箱为 465（SSL）或 587（STARTTLS）
    "Port": 465,
    // SMTP 登录用户名（通常就是邮箱地址）
    "UserName": "请替换为你的邮箱@qq.com",
    // SMTP 登录密码（QQ邮箱需使用授权码，非登录密码）
    "Password": "请替换为QQ邮箱授权码",
    // 发件人邮箱地址
    "From": "请替换为你的邮箱@qq.com",
    // 是否启用 SSL
    "EnableSsl": true
  },

  // ---- 评论通知 ----
  "CommentNotification": {
    // 博客前台域名，用于生成评论通知中的文章链接
    // 格式: https://www.example.com/#
    "Domain": "https://www.example.cn/#"
  },

  // 允许访问的主机名，* 表示不限制
  "AllowedHosts": "*"
}
